# ---- n8n runtime (copy to n8n/.env; this file is git-ignored) ----

# Encrypts credentials stored in n8n's database. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# HMAC secret Convex uses to sign webhooks sent TO n8n.
# Must equal LENDLOOP_TO_N8N_SECRET on the Convex deployment. Generate: openssl rand -hex 32
LENDLOOP_TO_N8N_SECRET=

# HMAC secret n8n uses to sign requests sent TO Convex HTTP endpoints.
# Must equal N8N_TO_LENDLOOP_SECRET on the Convex deployment. Generate: openssl rand -hex 32
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions base URL (the ".convex.site" URL, or the local backend's 3211 port).
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Who notification emails come from, and where operational alerts go.
LENDLOOP_NOTIFY_FROM=LendLoop <no-reply@lendloop.local>
LENDLOOP_OPS_EMAIL=ops@lendloop.local

# SMTP used to create the "LendLoop SMTP" n8n credential on first boot.
# Defaults point at the bundled Mailpit catcher. For real email use your provider's SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
