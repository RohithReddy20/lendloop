# ---- Next.js (copy to .env.local) ----
# `npx convex dev` writes CONVEX_DEPLOYMENT + NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment (NOT read from this file) ----
# Set with `npx convex env set NAME value`, or run scripts/setup-local.sh:
#   CLERK_JWT_ISSUER_DOMAIN       Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#   LENDLOOP_TO_N8N_SECRET        HMAC secret for Convex -> n8n webhooks (same value as in n8n/.env)
#   N8N_TO_LENDLOOP_SECRET        HMAC secret for n8n -> Convex calls (same value as in n8n/.env)
#   N8N_LOAN_EVENTS_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop/loan-events
#   SITE_URL                      e.g. http://localhost:3000 (used for links in notifications)
#   ALLOW_DEMO_SEED               "true" to allow `npx convex run seed:demo` (dev only)
